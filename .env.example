# Workforce Hub 本机 / Docker Compose 变量样板
# 只填写占位值，不要把真实密码、授权码、Access Key 提交到仓库。
# 本机运行时可复制为仓库根目录 .env；server/ 目录启动时会自动读取 ../.env。

# ==================== Spring Profile ====================
SPRING_PROFILES_ACTIVE=api
# 本机端口冲突时可改成 8082 / 8083 等空闲端口
SERVER_PORT=8080

# ==================== Employee Web ====================
# employee-web 本地开发默认通过 Vite 代理访问后端；后端端口变化时改这里。
VITE_API_PROXY_TARGET=http://localhost:8080
# 生产或预览环境需要跨域直连后端时再配置。
VITE_API_BASE_URL=

# ==================== MySQL (主业务库) ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workforce_hub
DB_USER=root
DB_PASSWORD=change_me

# ==================== MySQL (集成测试库) ====================
# module-org 集成测试默认会落到独立测试库，避免污染主业务库
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_NAME=workforce_hub_test
TEST_DB_USER=root
TEST_DB_PASSWORD=change_me

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== IM Outbox ====================
IM_OUTBOX_DISPATCHER_ENABLED=true
IM_OUTBOX_DISPATCHER_BATCH_SIZE=100
IM_OUTBOX_DISPATCHER_MAX_ATTEMPTS=5
IM_OUTBOX_DISPATCHER_RETRY_DELAY_MS=5000
IM_OUTBOX_DISPATCHER_SENDING_STALE_MS=60000
IM_OUTBOX_DISPATCHER_FIXED_DELAY_MS=3000
IM_OUTBOX_DISPATCHER_INITIAL_DELAY_MS=3000

# ==================== Mail (本地测试默认值) ====================
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=noreply@workforce-hub.local
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
# 当前阶段默认不把 SMTP 纳入健康探活，避免本地未起 MailHog/Mailpit 时总健康变成 DOWN。
# 邮件链路接入完成后，可在部署环境显式改为 true。
MAIL_HEALTH_ENABLED=false

# 网易 163 SMTP 示例：
# MAIL_HOST=smtp.163.com
# MAIL_PORT=465
# MAIL_USERNAME=yourname@163.com
# MAIL_PASSWORD=your_smtp_authorization_code
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_SSL_ENABLE=true
# MAIL_SMTP_STARTTLS=false

# ==================== Mail Smoke Test (默认关闭) ====================
# 设置为 true 后，ModuleAuthMailSmtpSmokeTest 会调用真实 SMTP 发送验证码。
# MAIL_SMOKE_TO 为空时默认发给 MAIL_USERNAME。
MAIL_SMOKE_ENABLED=false
MAIL_SMOKE_TO=

# ==================== Flowable ====================
# 开发环境可保持 true 便于联调；生产环境部署时应显式置为 false
FLOWABLE_DB_SCHEMA_UPDATE=true

# ==================== Agent Model (OpenAI Compatible) ====================
# 默认关闭；接真实模型时必须显式开启并配置 OpenAI 兼容服务。
# AGENT_MODEL_BASE_URL 示例：http://localhost:11434/v1、https://api.deepseek.com、https://api.openai.com/v1
# 兼容完整 Chat Completions endpoint，服务会自动收敛为 Spring AI 需要的服务根地址。
AGENT_MODEL_ENABLED=false
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
AGENT_MODEL_TIMEOUT=30s
AGENT_MODEL_MAX_TOKENS=1024
AGENT_MODEL_TEMPERATURE=0.2

# ==================== RAGFlow Vector DB (PostgreSQL + pgvector) ====================
RAGFLOW_VECTOR_ENABLED=false
RAGFLOW_VECTOR_URL=jdbc:postgresql://localhost:5432/workforce_hub_vector
RAGFLOW_VECTOR_USERNAME=postgres
RAGFLOW_VECTOR_PASSWORD=change_me

# ==================== MinIO ====================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=workforce-hub
