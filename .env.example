# Workforce Hub 本机 / Docker Compose 变量样板
# 只填写占位值，不要把真实密码、授权码、Access Key 提交到仓库。
# 该文件本身不会被 Spring Boot 自动加载，运行时请通过 IDE、shell 或 Docker Compose 注入。

# ==================== Spring Profile ====================
SPRING_PROFILES_ACTIVE=api
# 本机端口冲突时可改成 8082 / 8083 等空闲端口
SERVER_PORT=8080

# ==================== MySQL (主业务库) ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workforce_hub
DB_USER=root
DB_PASSWORD=change_me

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== Mail (本地测试默认值) ====================
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=noreply@workforce-hub.local
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
# 当前阶段默认不把 SMTP 纳入健康探活，避免本地未起 MailHog/Mailpit 时总健康变成 DOWN。
# 邮件链路接入完成后，可在部署环境显式改为 true。
MAIL_HEALTH_ENABLED=false

# 网易 163 SMTP 示例：
# MAIL_HOST=smtp.163.com
# MAIL_PORT=465
# MAIL_USERNAME=yourname@163.com
# MAIL_PASSWORD=your_smtp_authorization_code
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_SSL_ENABLE=true
# MAIL_SMTP_STARTTLS=false

# ==================== Flowable ====================
# 开发环境可保持 true 便于联调；生产环境部署时应显式置为 false
FLOWABLE_DB_SCHEMA_UPDATE=true

# ==================== MinIO ====================
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=workforce-hub
