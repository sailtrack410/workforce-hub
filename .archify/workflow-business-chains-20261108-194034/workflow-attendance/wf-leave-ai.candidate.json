  "cards": [
    {
      "dot": "cyan",
      "title": "余额与回调约束",
      "items": [
        "FREEZE以requestId构建幂等key，行锁内可用余额转冻结余额。",
        "AI通过不会自动批准；仍创建Flowable直属上级任务。",
        "AI拒绝、超时均走REJECTED并释放冻结；内部任务执行由Agent链路单独说明。"
      ]
    },
    {
      "dot": "amber",
      "title": "已知问题与边界",
      "items": [
        "沿用99-3：假种停用或扣减模式改变会影响后续结算。",
        "沿用99-4：固定9—12／13—18并按240分钟向上取整。",
        "预审未结束时页面仍显示撤回，后端只允许IN_APPROVAL。"
      ]
    }
  ]
