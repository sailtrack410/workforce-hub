  "cards": [
    {
      "dot": "cyan",
      "title": "结算与兼容",
      "items": [
        "DEDUCT／UNFREEZE使用requestId派生幂等key并核对指纹。",
        "历史无冻结流水可降级扣可用余额；驳回与撤回时无冻结流水直接跳过。",
        "失败抛错触发事务回滚；未动态验证数据库与Flowable共事务效果。"
      ]
    },
    {
      "dot": "amber",
      "title": "优化",
      "items": [
        "页面撤回资格应按状态控制，或明确支持预审中取消。",
        "内置单步审批结束后直接完成业务；引入多级BPMN需同步改造任务推进与待办生成。"
      ]
    }
  ]
