  "cards": [
    {
      "dot": "cyan",
      "title": "范围与实现",
      "items": [
        "显式工具调用的人审、恢复执行、拒绝取消、超时扫描及DAG分支差异。",
        "员工任务确认/取消API已实现；DAG APPROVAL是提示节点，不代表持久人审暂停。"
      ]
    },
    {
      "dot": "amber",
      "title": "异常与恢复",
      "items": [
        "显式工具调用有持久化人审；DAG工具路径没有等价审批门禁。",
        "超时扫描只取消WAITING_HUMAN_CONFIRM，不恢复PENDING/RUNNING。"
      ]
    }
