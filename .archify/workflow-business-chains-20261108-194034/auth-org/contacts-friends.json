  "cards": [
    {
      "dot": "cyan",
      "title": "关系语义",
      "items": [
        "接受好友申请后形成双向ACTIVE；备注只更新本人方向；移除同时删除两个方向。",
        "没有独立拒绝接口；DELETE可删除待接受关系，但当前页面未提供明确拒绝操作。"
      ]
    },
    {
      "dot": "amber",
      "title": "优化建议",
      "items": [
        "补发出申请状态与拒绝操作，避免用户只看到“已发送好友申请”冲突提示。",
        "同时互加／接受的真实并发结果尚未验证，应以唯一键与事务竞争专项测试验收。"
      ]
    }
  ]
